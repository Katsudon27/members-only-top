<%= form_with model: @post do |form| %>
    <div>
        <%= form.label :title, "Enter the title:" %><br>
        <%= form.text_field :title %>
    </div>
    <br>
    <div>
        <%= form.label :body, "Enter the body:" %><br>
        <%= form.textarea :body %>
    </div>
    <br>
    <%= form.submit "Create Post" %>
<% end %>